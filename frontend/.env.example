# ==============================================================================
#                      AKADEMI PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Branding
VITE_APP_NAME="Akademi"
VITE_APP_URL="http://localhost:5173"
VITE_API_BASE_URL="http://localhost:8000/api"

# ------------------------------------------------------------------------------
# 1. PAYSTACK PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Get your keys at: https://dashboard.paystack.com/#/settings/developer
VITE_PAYSTACK_PUBLIC_KEY="pk_test_a1b2c3d4e5f67890abcdef1234567890abcdef"
VITE_PLATFORM_COMMISSION_PERCENT=10
VITE_MIN_PAYOUT_AMOUNT_NGN=5000

# ------------------------------------------------------------------------------
# 2. WEBRTC SFU CLOUD MEDIA SERVER (LiveKit / Agora)
# ------------------------------------------------------------------------------
# Selective Forwarding Unit for >8 participant masterclasses & low-bandwidth mobile
VITE_SFU_PROVIDER="livekit"
VITE_LIVEKIT_URL="wss://livekit.cloud.akademi.dev"
VITE_SFU_AUTO_SWITCH_THRESHOLD=8
VITE_SFU_ECO_MOBILE_MODE=true

# ------------------------------------------------------------------------------
# 3. WEBSOCKETS & MOBILE PUSH NOTIFICATIONS (Pusher / Soketi)
# ------------------------------------------------------------------------------
# Get your keys at: https://dashboard.pusher.com/
VITE_PUSHER_APP_KEY="AKADEMI_PUSHER_KEY_2026"
VITE_PUSHER_APP_CLUSTER="eu"
VITE_PUSHER_APP_ID="1892345"

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH & CALENDAR 2-WAY SYNC
# ------------------------------------------------------------------------------
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID="108392819283-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# 5. PLATFORM FEATURE MODULE TOGGLES
# ------------------------------------------------------------------------------
# Set to 'false' to hide during initial tutor/student launch, 'true' when launching
VITE_ENABLE_COMMUNITIES=false
VITE_ENABLE_LEARN_TOKENS=true
VITE_RECORDING_RETENTION_DAYS=10
# URL of the Akademi Community app (separate deployment)
VITE_COMMUNITY_URL=
